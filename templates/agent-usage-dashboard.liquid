<style>
  .agent-usage-screen, .agent-usage-screen * { box-sizing: border-box; }
  .agent-usage-screen {
    color-scheme: light;
    width: 800px;
    height: 480px;
    overflow: hidden;
    background: #fff;
    color: #000;
    font-family: Inter, Arial, Helvetica, sans-serif;
    padding: 4px;
    display: grid;
    grid-template-rows: 34px 58px 190px 146px 22px;
    gap: 4px;
  }
  .agent-usage-screen .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
    align-items: center;
    border-bottom: 4px solid #000;
    min-width: 0;
  }
  .agent-usage-screen .title {
    min-width: 0;
    font-size: 30px;
    line-height: 1;
    font-weight: 900;
    white-space: nowrap;
    overflow: hidden;
  }
  .agent-usage-screen .meta {
    font-size: 13px;
    line-height: 1;
    font-weight: 900;
    text-align: right;
    white-space: nowrap;
  }
  .agent-usage-screen .limits {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 10px;
    min-height: 0;
  }
  .agent-usage-screen .limits--3 .limit-label { font-size: 12px; }
  .agent-usage-screen .limits--3 .limit-used { font-size: 26px; }
  .agent-usage-screen .limits--3 .limit-reset { font-size: 11px; }
  .agent-usage-screen .limits--3 .limit-line { gap: 5px; }
  .agent-usage-screen .limit {
    min-width: 0;
    border-top: 3px solid #000;
    padding-top: 4px;
  }
  .agent-usage-screen .limit-line {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 7px;
    align-items: baseline;
    min-width: 0;
  }
  .agent-usage-screen .limit-label {
    font-size: 15px;
    line-height: 1;
    font-weight: 900;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .agent-usage-screen .limit-used {
    font-size: 30px;
    line-height: .92;
    font-weight: 900;
    color: #ff0000;
    white-space: nowrap;
  }
  .agent-usage-screen .limit-reset {
    font-size: 14px;
    line-height: 1;
    font-weight: 900;
    text-align: right;
    white-space: nowrap;
  }
  .agent-usage-screen .bar {
    height: 14px;
    margin-top: 5px;
    border: 2px solid #000;
    background: #fff;
    overflow: hidden;
  }
  .agent-usage-screen .bar-empty {
    background: #fff;
  }
  .agent-usage-screen .fill {
    height: 100%;
    min-width: 0;
    background: #0000ff;
  }
  .agent-usage-screen .main {
    display: grid;
    grid-template-columns: 248px 256px 272px;
    gap: 8px;
    min-height: 0;
  }
  .agent-usage-screen .panel {
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-top: 4px solid #000;
    padding-top: 5px;
  }
  .agent-usage-screen .panel + .panel {
    border-left: 2px solid #000;
    padding-left: 8px;
  }
  .agent-usage-screen .label {
    font-size: 13px;
    line-height: 1;
    font-weight: 900;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
  }
  .agent-usage-screen .hero-value {
    margin-top: 4px;
    font-size: 50px;
    line-height: .9;
    font-weight: 900;
    color: #0000ff;
    white-space: nowrap;
    overflow: hidden;
  }
  .agent-usage-screen .subline {
    margin-top: 4px;
    font-size: 14px;
    line-height: 1;
    font-weight: 900;
    white-space: nowrap;
    overflow: hidden;
  }
  .agent-usage-screen .metric-grid {
    margin-top: 7px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }
  .agent-usage-screen .metric {
    min-width: 0;
    border-top: 2px solid #000;
    padding-top: 3px;
  }
  .agent-usage-screen .metric-label {
    font-size: 11px;
    line-height: 1;
    font-weight: 900;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
  }
  .agent-usage-screen .metric-value {
    margin-top: 2px;
    font-size: 23px;
    line-height: .95;
    font-weight: 900;
    white-space: nowrap;
    overflow: hidden;
  }
  .agent-usage-screen .blue { color: #0000ff; }
  .agent-usage-screen .red { color: #ff0000; }
  .agent-usage-screen .green { color: #00aa00; }
  .agent-usage-screen .status-list {
    margin-top: 6px;
    display: grid;
    gap: 3px;
  }
  .agent-usage-screen .status-row {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 6px;
    min-width: 0;
    border-top: 2px solid #000;
    padding-top: 3px;
  }
  .agent-usage-screen .status-key {
    font-size: 11px;
    line-height: 1;
    font-weight: 900;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
  }
  .agent-usage-screen .status-val {
    font-size: 14px;
    line-height: 1;
    font-weight: 900;
    white-space: nowrap;
    overflow: hidden;
  }
  .agent-usage-screen .account-val { font-size: 12px; }
  .agent-usage-screen .lower {
    display: grid;
    grid-template-columns: 460px 320px;
    gap: 10px;
    min-height: 0;
  }
  .agent-usage-screen .models, .agent-usage-screen .trend {
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-top: 4px solid #000;
    padding-top: 5px;
  }
  .agent-usage-screen .trend { border-left: 2px solid #000; padding-left: 8px; }
  .agent-usage-screen .model-row {
    display: grid;
    grid-template-columns: 188px 64px 1fr;
    gap: 7px;
    align-items: center;
    min-width: 0;
    margin-top: 7px;
  }
  .agent-usage-screen .model-name, .agent-usage-screen .model-tokens {
    font-size: 14px;
    line-height: 1;
    font-weight: 900;
    white-space: nowrap;
    overflow: hidden;
  }
  .agent-usage-screen .model-tokens { text-align: right; }
  .agent-usage-screen .smallbar {
    height: 12px;
    border: 2px solid #000;
    background: #fff;
    overflow: hidden;
  }
  .agent-usage-screen .smallfill { height: 100%; background: #00aa00; min-width: 0; }
  .agent-usage-screen .day-row {
    display: grid;
    grid-template-columns: 34px 64px 1fr;
    gap: 6px;
    align-items: center;
    margin-top: 3px;
  }
  .agent-usage-screen .day-label, .agent-usage-screen .day-val {
    font-size: 11px;
    line-height: 1;
    font-weight: 900;
    white-space: nowrap;
    overflow: hidden;
  }
  .agent-usage-screen .day-val { text-align: right; }
  .agent-usage-screen .trend .smallbar { height: 10px; }
  .agent-usage-screen .foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
    align-items: center;
    border-top: 3px solid #000;
    padding-top: 4px;
    min-width: 0;
    font-size: 12px;
    line-height: 1;
    font-weight: 900;
  }
  .agent-usage-screen .foot-left, .agent-usage-screen .foot-right {
    white-space: nowrap;
    overflow: hidden;
  }
  .agent-usage-screen .foot-right { text-align: right; }
</style>

{% assign s = source_1 %}
{% assign reset_count = s.resets.count | default: 0 | plus: 0 %}
{% assign credit_balance = s.credits.balance | default: 0 | plus: 0 %}
{% assign cloud_balance = s.credits.cloud.balance | default: 0 | plus: 0 %}

{%- capture visible_limit_keys -%}
  {%- if s.limits.primary.used and s.limits.primary.used != 'n/a' -%},primary{%- endif -%}
  {%- unless s.limits.primary.window == '7d' and s.limits.primary.used and s.limits.primary.used != 'n/a' -%}
    {%- if s.limits.weekly.used and s.limits.weekly.used != 'n/a' -%},weekly{%- endif -%}
  {%- endunless -%}
  {%- if s.kind == 'claude' and s.limits.scoped.used and s.limits.scoped.used != 'n/a' -%},scoped{%- endif -%}
{%- endcapture -%}
{% assign visible_limit_keys = visible_limit_keys | remove_first: ',' | split: ',' %}

<div class="agent-usage-screen">
  <header class="top">
    <div class="title">{{ s.title }}</div>
    <div class="meta">{{ s.local_datetime }} &middot; refresh {{ s.refresh }} &middot; {{ s.cost_basis }}</div>
  </header>

  {% if s.ok == false %}
    <section class="main" style="grid-column: 1 / -1;">
      <div class="panel">
        <div class="label">Feed error</div>
        <div class="hero-value red">NO DATA</div>
        <div class="subline">{{ s.errors[0] }}</div>
      </div>
    </section>
  {% else %}
    <section class="limits limits--{{ visible_limit_keys.size }}">
      {% for limit_key in visible_limit_keys %}
        {% assign quota = s.limits[limit_key] %}
        <div class="limit">
          <div class="limit-line">
            <div class="limit-label">{{ quota.label }}</div>
            <div class="limit-used">{{ quota.used }}</div>
            <div class="limit-reset">{{ quota.window }} reset {{ quota.reset }}</div>
          </div>
          <div class="bar"><div class="fill" style="width: {{ quota.used_percent }}%;"></div></div>
        </div>
      {% else %}
        <div class="limit"><div class="limit-label">Limits unavailable</div><div class="bar bar-empty"></div></div>
      {% endfor %}
    </section>

    <section class="main">
      <div class="panel">
        <div class="label">{{ s.usage.five_hour.label }} tokens</div>
        <div class="hero-value">{{ s.usage.five_hour.total }}</div>
        <div class="subline">cost {{ s.usage.five_hour.cost }} &middot; cache {{ s.usage.five_hour.cache_hit }} &middot; n {{ s.usage.five_hour.sessions }}</div>
        <div class="metric-grid">
          <div class="metric"><div class="metric-label">Input</div><div class="metric-value">{{ s.usage.five_hour.input }}</div></div>
          <div class="metric"><div class="metric-label">Output</div><div class="metric-value red">{{ s.usage.five_hour.output }}</div></div>
          <div class="metric"><div class="metric-label">Cache read</div><div class="metric-value green">{{ s.usage.five_hour.cache_read }}</div></div>
          <div class="metric"><div class="metric-label">Reasoning</div><div class="metric-value">{{ s.usage.five_hour.reasoning }}</div></div>
        </div>
      </div>

      <div class="panel">
        <div class="label">{% if s.account_usage.lifetime %}Local / account totals{% else %}Local usage totals{% endif %}</div>
        <div class="metric-grid">
          <div class="metric"><div class="metric-label">Today</div><div class="metric-value blue">{{ s.usage.today.total }}</div></div>
          <div class="metric"><div class="metric-label">Today Token Cost*</div><div class="metric-value">{{ s.usage.today.cost }}</div></div>
          <div class="metric"><div class="metric-label">Local 7d</div><div class="metric-value blue">{{ s.usage.week.total }}</div></div>
          <div class="metric"><div class="metric-label">7d Token Cost*</div><div class="metric-value">{{ s.usage.week.cost }}</div></div>
          <div class="metric"><div class="metric-label">Local month</div><div class="metric-value">{{ s.usage.month.total }}</div></div>
          <div class="metric"><div class="metric-label">{% if s.account_usage.lifetime %}Account all{% else %}Local all{% endif %}</div><div class="metric-value">{% if s.account_usage.lifetime %}{{ s.account_usage.lifetime }}{% else %}{{ s.usage.all.total }}{% endif %}</div></div>
        </div>
      </div>

      <div class="panel">
        <div class="label">{% if s.kind == 'codex' %}Codex account{% else %}Claude account / block{% endif %}</div>
        <div class="status-list">
          {% if reset_count > 0 %}<div class="status-row"><div class="status-key">Resets</div><div class="status-val account-val">{{ reset_count }}{% if s.resets.expires %} &middot; exp {{ s.resets.expires }}{% endif %}</div></div>{% endif %}
          {% if credit_balance > 0 %}<div class="status-row"><div class="status-key">Credits</div><div class="status-val account-val">{{ s.credits.display | default: s.credits.balance | escape }}</div></div>{% endif %}
          {% if cloud_balance > 0 %}<div class="status-row"><div class="status-key">Cloud credits</div><div class="status-val account-val">{{ s.credits.cloud.display | escape }}{% if s.credits.cloud.expires %} &middot; exp {{ s.credits.cloud.expires }}{% endif %}</div></div>{% endif %}
          {% if s.kind == 'codex' %}
            {% if s.limits.primary.used and s.limits.primary.used != 'n/a' %}
            <div class="status-row"><div class="status-key">{% if s.limits.primary.label == 'Weekly all' %}Week{% else %}{{ s.limits.primary.label }}{% endif %} reset</div><div class="status-val">{{ s.limits.primary.reset_full }}</div></div>
            {% endif %}
            {% if s.limits.weekly.used and s.limits.weekly.used != 'n/a' %}
            <div class="status-row"><div class="status-key">{% if s.limits.weekly.label == 'Weekly all' %}Week{% else %}{{ s.limits.weekly.label }}{% endif %} reset</div><div class="status-val">{{ s.limits.weekly.reset_full }}</div></div>
            {% endif %}
            {% if s.limits.extra %}<div class="status-row"><div class="status-key">{% if s.limits.extra.label == 'Weekly all' %}Week{% else %}{{ s.limits.extra.label }}{% endif %} {{ s.limits.extra.window }}</div><div class="status-val">{{ s.limits.extra.used }} &middot; {{ s.limits.extra.reset }}</div></div>{% endif %}
            {% if s.account_usage.current_streak %}<div class="status-row"><div class="status-key">Streak</div><div class="status-val">{{ s.account_usage.current_streak }}d &middot; peak {{ s.account_usage.peak_day }}</div></div>{% endif %}
          {% else %}
            <div class="status-row"><div class="status-key">Block left</div><div class="status-val">{{ s.block.remaining }} min</div></div>
            <div class="status-row"><div class="status-key">Burn</div><div class="status-val">{{ s.block.burn_tokens_min }}/m · {{ s.block.burn_cost_hr }}/h</div></div>
            <div class="status-row"><div class="status-key">Projected</div><div class="status-val">{{ s.block.projected_tokens }} / {{ s.block.projected_cost }}</div></div>
            <div class="status-row"><div class="status-key">Usage auth</div><div class="status-val">{{ s.auth.usage }}</div></div>
          {% endif %}
        </div>
      </div>
    </section>

    <section class="lower">
      <div class="models">
        <div class="label">Local models, 7d</div>
        {% for m in s.models limit: 5 %}
          <div class="model-row">
            <div class="model-name">{{ m.name }}</div>
            <div class="model-tokens">{{ m.tokens }}</div>
            <div class="smallbar"><div class="smallfill" style="width: {{ m.pct }}%;"></div></div>
          </div>
        {% endfor %}
      </div>

      <div class="trend">
        <div class="label">{{ s.activity_scope | default: 'Daily activity' }}</div>
        {% for d in s.daily_bars limit: 7 %}
          <div class="day-row">
            <div class="day-label">{{ d.day }}</div>
            <div class="day-val">{{ d.tokens }}</div>
            <div class="smallbar"><div class="smallfill" style="width: {{ d.pct }}%;"></div></div>
          </div>
        {% endfor %}
      </div>
    </section>

  <footer class="foot">
      <div class="foot-left">{% if s.runtime %}{{ s.runtime }} &middot; local last {{ s.local_latest }}{% else %}{{ s.source }}{% endif %}</div>
      <div class="foot-right">sess {{ s.sessions.today }}/{{ s.sessions.week }}/{{ s.sessions.all }}{% if s.kind == 'claude' and s.statusline and s.statusline.captured_age %} &middot; limits {{ s.statusline.captured_age }}{% endif %}</div>
    </footer>
  {% endif %}
</div>
